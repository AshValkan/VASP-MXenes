<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', display: 'flex', flexDirection: 'column', padding: 0 }}>

    <Box style={{ height: 72, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF' }}>计算体系与方法参数</Text>
        <Text style={{ fontSize: 15, color: '#A9C4EC', letterSpacing: 2 }}>01 · 计算方法</Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'row', gap: 26, padding: '22px 40px' }}>

        <Box style={{ width: 330, flexDirection: 'column', gap: 14 }}>

            <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: '18px 22px', flexDirection: 'column', gap: 10 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 5, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>成分扫描设计</Text>
                </Box>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1A2230' }}>
                    Ti<span style={{ fontSize: 13 }}>3−y</span>V<span style={{ fontSize: 13 }}>y</span>C<span style={{ fontSize: 13 }}>2</span>O<span style={{ fontSize: 13 }}>2</span>（O 端基）
                </Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.75 }}>
                    s2×2 超胞，V 替代外层 Ti 位点<br />成分点 y = 0 / 0.5 / 1.0 / 1.5<br />y = 0 端点为 Ti₃C₂ 基线对照
                </Text>
            </Box>

            <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: '18px 22px', flexDirection: 'column', gap: 10 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 5, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>提速与精度折衷</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.75 }}>
                    SIGMA 0.05 → 0.10 eV<br />k 网格 4×4×1 → 3×3×1<br />电子步成本显著下降
                </Text>
                <Text style={{ fontSize: 15, color: '#0E3F8C', lineHeight: 1.7 }}>
                    折衷以形成能趋势与 d 带中心对比为目标；关键成分点可加密 k 点复核
                </Text>
            </Box>

            <Box style={{ height: 78, background: '#0E3F8C', borderRadius: 8, padding: '14px 20px', justifyContent: 'center' }}>
                <Text style={{ fontSize: 15, color: '#FFFFFF', lineHeight: 1.65 }}>
                    上述参数为 4 个成分点统一配置，与服务器各任务 INCAR 实文件逐一核对一致
                </Text>
            </Box>

        </Box>

        <Box style={{ flex: 1, flexDirection: 'column', gap: 10 }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>INCAR 关键参数</Text>
            <Table
                style={{ width: '100%', flex: 1 }}
                defaultTextStyle={{ fontSize: 17, textAlign: 'center', color: '#1A2230' }}
                defaultCellStyle={{
                    border: {
                        left: { width: 1, color: '#D6DCE5' },
                        right: { width: 1, color: '#D6DCE5' },
                        top: { width: 1, color: '#D6DCE5' },
                        bottom: { width: 1, color: '#D6DCE5' },
                    },
                }}
                cells={[
                    [
                        { text: '参数', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                        { text: '设定值', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                        { text: '说明', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                    ],
                    ['交换关联泛函', 'PBE (GGA)', 'PAW 赝势'],
                    ['DFT+U 校正', 'U = 2.5 eV', 'Ti / V d 轨道'],
                    ['平面波截断能', 'ENCUT = 550 eV', '基组收敛'],
                    ['k 点网格', '3×3×1', 'Γ 中心'],
                    ['自旋极化', 'ISPIN = 2', '磁性基态'],
                    ['色散校正', 'IVDW = 11', 'DFT-D3'],
                    ['展宽', 'SIGMA = 0.10 eV', '提速折衷'],
                    ['电子步收敛', 'EDIFF = 1×10⁻⁵ eV', 'SCF 判据'],
                    ['离子步收敛', 'EDIFFG = −0.02 eV/Å', '力判据'],
                    ['线性混合', 'AMIX = 0.2 · BMIX = 0.0001', 'SCF 稳幅'],
                    ['实空间投影', 'LREAL = AUTO', '超胞提速'],
                ]}
            />
        </Box>

    </Box>

    <Box style={{ height: 59, background: '#F7F9FC', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
        <Text style={{ fontSize: 13, color: '#8B97A8' }}>V 合金化 Ti₃C₂ MXene · DFT 计算进展汇报</Text>
        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#1E4FA8' }}>04 / 09</Text>
    </Box>

</Slide>
