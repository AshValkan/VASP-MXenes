                    </Box>
                    <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.55 }}>Xeon E5-2630v4 × 2<br />20 物理核 / 40 线程 · 46 GB 内存<br />MPI 按物理核布局</Text>
                </Box>

                <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: '10px 14px', flexDirection: 'column', gap: 4 }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <FAIcon name='code-branch' style={{ fill: '#1E4FA8', width: 22, height: 22 }} />
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1A2230' }}>代码仓库</Text>
                    </Box>
                    <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.55 }}>fork AshValkan/VASP-MXenes<br />分支 alloy-mxene-tiv<br />自测 68/68 全部通过</Text>
                </Box>
            </Box>

        </Box>

        <Box style={{ height: 74, background: '#0E3F8C', borderRadius: 8, flexDirection: 'row', alignItems: 'center', gap: 14, padding: '0 24px' }}>
