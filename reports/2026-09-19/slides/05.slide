                    <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.55 }}>VASP 6.4.2（vasp_std）<br />OpenMPI 5.0.10 + PMIx 5.0.1<br />Python 3 独立虚拟环境</Text>
                </Box>

                <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: '10px 14px', flexDirection: 'column', gap: 4 }}>
