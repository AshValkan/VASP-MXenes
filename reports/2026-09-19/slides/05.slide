                    </Box>
                </Box>
                <Box style={{ height: 11, width: 34, marginLeft: 28, justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='arrow-down' style={{ fill: '#8B97A8', width: 12, height: 12 }} />
                </Box>

                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#E8EFF8', border: '1.5px solid #1E4FA8', borderRadius: 6, padding: '6px 12px' }}>
                    <Box style={{ width: 34, height: 34, background: '#0E3F8C', borderRadius: 5, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', flex: 1 }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0E3F8C' }}>opt 离子弛豫 · 4 成分点 × MPI-5</Text>
                        <Text style={{ fontSize: 12, color: '#4A5568' }}>OSZICAR / OUTCAR 实时监控</Text>
                    </Box>
                    <Box style={{ background: '#1E4FA8', borderRadius: 9, padding: '3px 10px' }}>
                        <Text style={{ fontSize: 12, color: '#FFFFFF' }}>运行中</Text>
                    </Box>
                </Box>
                <Box style={{ height: 11, width: 34, marginLeft: 28, justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='arrow-down' style={{ fill: '#8B97A8', width: 12, height: 12 }} />
                </Box>

                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#FFFFFF', border: '1px dashed #8B97A8', borderRadius: 6, padding: '6px 12px' }}>
                    <Box style={{ width: 34, height: 34, background: '#8B97A8', borderRadius: 5, justifyContent: 'center', alignItems: 'center' }}>
