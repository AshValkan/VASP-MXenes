        <Text style={{ fontSize: 15, color: '#A9C4EC', letterSpacing: 2 }}>02 · 平台与工作流</Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', gap: 14, padding: '20px 40px' }}>

        <Box style={{ flexDirection: 'row', gap: 26, height: 461 }}>

            <Box style={{ width: 620, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: '12px 18px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C', marginBottom: 4 }}>自动化工作流（VASP-MXenes 定制）</Text>

                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: '6px 12px' }}>
                    <Box style={{ width: 34, height: 34, background: '#1E4FA8', borderRadius: 5, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1A2230' }}>alloy_config</Text>
                        <Text style={{ fontSize: 12, color: '#4A5568' }}>成分 · 超胞 · 端基配置</Text>
                    </Box>
                </Box>
                <Box style={{ height: 11, width: 34, marginLeft: 28, justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='arrow-down' style={{ fill: '#8B97A8', width: 12, height: 12 }} />
                </Box>

                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 6, padding: '6px 12px' }}>
                    <Box style={{ width: 34, height: 34, background: '#1E4FA8', borderRadius: 5, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1A2230' }}>alloy.py 结构生成</Text>
