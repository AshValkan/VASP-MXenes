    <Box style={{ flex: 1, flexDirection: 'column', gap: 16, padding: '20px 40px' }}>

        <Box style={{ flexDirection: 'row', gap: 16 }}>
            <Box style={{ flex: 1, background: '#0E3F8C', borderRadius: 8, padding: '16px 20px', flexDirection: 'column', gap: 6 }}>
