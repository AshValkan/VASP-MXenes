                <Text style={{ fontSize: 14, color: '#4A5568' }}>k=5×5×1，ISMEAR=-5，NEDOS=5000</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: '16px 20px', flexDirection: 'column', gap: 6 }}>
                <Text style={{ fontSize: 27, fontWeight: 'bold', color: '#0E3F8C' }}>R² ≈ 0.77</Text>
                <Text style={{ fontSize: 14, color: '#4A5568' }}>ε_d(Ti)–y 线性拟合（ε_d(V)：0.75）</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: '16px 20px', flexDirection: 'column', gap: 6 }}>
                <Text style={{ fontSize: 27, fontWeight: 'bold', color: '#0E3F8C' }}>N(E_F) ×18</Text>
                <Text style={{ fontSize: 14, color: '#4A5568' }}>费米面态密度 0.55 → 9.9 states</Text>
            </Box>
        </Box>

        <Box style={{ flex: 1, flexDirection: 'column', gap: 10 }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>四成分点计算结果汇总（2026-09-17 分析产出）</Text>
            <Table
                style={{ width: '100%', flex: 1 }}
                defaultTextStyle={{ fontSize: 16, textAlign: 'center', color: '#1A2230' }}
                defaultCellStyle={{
                    border: {
