#!/bin/bash
# Local server runner for VASP-MXenes on <user>@<server>
# Replaces the IQTC/BSC cluster scripts: no scheduler, no `module load`.
# Run inside a case directory:  bash script
export OMP_NUM_THREADS=1
VASP_BIN="$HOME/calc/vasp_std"
NPROC=${NPROC:-8}

if [ ! -x "$VASP_BIN" ]; then
  echo "ERROR: vasp_std not found/executable at $VASP_BIN" >&2
  exit 1
fi

echo "Running $VASP_BIN with $NPROC MPI ranks in $PWD"
mpirun -np "$NPROC" "$VASP_BIN"
